# ─────────────────────────────────────────────────────────────────────────
#  VisaVulnerabilityAgenticHarness .gitignore — hardened for a PUBLIC repo.
#  Goal: secrets, internal data, and runtime artifacts can never be committed.
#  Template files (*.example) are explicitly re-included.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets & credentials ─────────────────────────────────────────────────
.env
.env.*
!.env.example
# Scoped secret/credential text dumps only — NOT a blanket *.txt (which would
# swallow LICENSEs, fixtures, and any tracked text file tree-wide).
*secret*.txt
*secrets*.txt
*token*.txt
*credentials*.txt
.claude
*.pem
*.key
*.p12
*.pfx
*.jks
*.der
*.crt
*.xlsx
# Local config override (machine-specific keys / endpoints; never published)
config.local.yaml

# CMDB export (real app data: externally-facing/PCI/PAN/PII flags, internal
# app ids; each user supplies their own). Ignore the real file, keep only the
# *.example.csv template.
inputs/cmdb*.csv
!inputs/cmdb*.example.csv
# Batch repo list (real internal clone URLs / hosts / app ids).
inputs/repos*.csv
!inputs/repos*.example.csv
# Design-controls (describes internal security architecture in `notes`).
inputs/design_controls*.yaml
!inputs/design_controls*.example.yaml
# Live CVE feeds — keep only the *.example.json templates.
inputs/known_cves*.json
!inputs/known_cves*.example.json

# ── Scan outputs & generated reports ──────────────────────────────────────
scans*/
security-scan/
batch-workspace/
out/
*.sarif
*_report.md
*_report.md.bak

# ── Runtime state & caches ────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
build/
dist/
.venv/
.venv.*
venv/
*.log
*.jsonl
*.bak
run_manifest.json

# ── Editor / OS cruft ─────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
node_modules/



# user-local config override (copied from a profile) — never commit
config.yaml
.venv-test
.pytest-deps
