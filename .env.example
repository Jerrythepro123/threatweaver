# vvaharness environment — copy to .env and fill in.
# vvaharness auto-loads this file (searched from the working directory upward),
# so no manual `source` is needed. Shell-exported vars take precedence.
#
# The DEFAULT profile (default.yaml) runs every role through the `claude` CLI
# and reuses your Claude Code login — it needs NONE of the keys below (run
# `claude` then `/login`, or set CLAUDE_CODE_OAUTH_TOKEN). The vars here are for
# the SDK / OpenAI backends (e.g. the sdk.yaml and full.yaml profiles).

# ── Anthropic SDK (required for `via: sdk` roles — e.g. full.yaml) ───────────
ANTHROPIC_SDK_API_KEY=

# Optional Anthropic gateway / mTLS overrides (leave blank for public API)
ANTHROPIC_SDK_BASE_URL=
# OPTIONAL — CA bundle for a private gateway / TLS-intercepting proxy whose
# server cert chains to an internal root CA. Leave blank for the public API.
ANTHROPIC_SDK_CA_CERT=
# OPTIONAL — client cert for mutual TLS (mTLS). Supported on `via: sdk` ONLY.
ANTHROPIC_SDK_CLIENT_CERT=

# ── Claude Code CLI (`via: cli` — the default profile) ───────────────────────
# Either run `claude` then `/login` once, or set a token (claude setup-token):
CLAUDE_CODE_OAUTH_TOKEN=
# OPTIONAL — CA bundle for the `claude` CLI subprocess (-> NODE_EXTRA_CA_CERTS).
# Leave blank to use the public endpoint / system trust store. Note: mTLS client
# certs are NOT supported on `via: cli` (use a `via: sdk` role for mTLS).
CLAUDE_CLI_CA_CERT=

# ── OpenAI (only if a role uses `via: openai` — see full.yaml) ───────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPTIONAL — CA bundle for a private gateway / TLS-intercepting proxy. Leave
# blank for the public API.
OPENAI_CA_CERT=

# ── Batch cloning (optional) ─────────────────────────────────────────────────
GITHUB_TOKEN=
GIT_BASE_URL=
